# Google OAuth Client ID (sama dengan GOOGLE_CLIENT_ID di backend).
# Aman ditaruh di frontend karena Client ID bersifat publik.
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Base URL backend API. Ganti sesuai environment (local / production).
VITE_API_BASE_URL=your-backend-api-base-url
